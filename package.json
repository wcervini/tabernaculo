{
  "name": "tabernaculo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestor de skills (Agent Skills) para agent-CLIs",
  "bin": {
    "tabernaculo": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --outfile tabernaculo src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
